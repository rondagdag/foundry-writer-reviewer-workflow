FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<model-deployment-name>

# --- Tracing (OpenTelemetry) ---
# Tracing is off unless a target is set. In the hosted Foundry runtime the agent
# server configures telemetry itself, so leave these unset there.
# Uncomment to export to a local OTLP collector (gRPC on 4317, http/protobuf on 4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc